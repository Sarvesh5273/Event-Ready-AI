# YouCam (PerfectCorp) Live Mode — see src/lib/youcam/.
# Leave YOUCAM_API_KEY unset to keep the app in Demo Mode only.
YOUCAM_API_KEY=""
YOUCAM_API_BASE_URL="https://yce-api-01.makeupar.com"

# The AI Clothes task endpoint version PerfectCorp has provisioned for this
# API key (see src/lib/youcam/clothesVto.ts). Defaults to "cloth-v4".
YOUCAM_CLOTH_TASK_NAME="cloth-v4"

# Operator kill-switch: force Demo Mode even when YOUCAM_API_KEY is set
# (e.g. to guarantee deterministic behavior during a live demo/judging
# without burning API units). Live Mode is only offered when this is
# "false" (or unset) AND YOUCAM_API_KEY is configured.
ENABLE_DEMO_MODE="true"

# Cache successful Skin Analysis / Apparel VTO results so a repeated,
# byte-identical upload doesn't burn additional YouCam API units.
ENABLE_REPLAY_CACHE="true"

# Signs stateless session tokens (already configured as a Replit secret in
# this project — do not put a real value here).
SESSION_SECRET=""
